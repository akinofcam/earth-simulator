{
  "name": "earth-simulator",
  "version": "0.1.0",
  "description": "Real-time geospatial simulation platform",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "start": "node dist/server/index.js",
    "seed": "ts-node src/db/seeds/seedConstellation.ts",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "ajv": "^8.0.0",
    "express": "^4.18.2",
    "maplibre-gl": "^5.20.0",
    "pg": "^8.11.0",
    "pg-format": "^1.0.4",
    "satellite.js": "^4.0.0",
    "three": "^0.161.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.5",
    "jest": "^29.6.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
